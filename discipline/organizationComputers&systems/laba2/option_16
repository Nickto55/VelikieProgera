#include <conio.h>
#include <dos.h>
#include <stdio.h>

#define X1 25
#define Y1 12
#define X2 55
#define Y2 23

#define T 600
#define S 1

char *bg_rus[8] = {
    "черн", "син", "зел", "с-зел", "крас", "к-син", "коричн", "с-сер"};

char *fg_eng[16] = {
    "BLACK", "BLUE", "GREEN", "CYAN", "RED", "MAGENTA", "BROWN", "LIGHTGRAY",
    "DARKGRAY", "LIGHTBLUE", "LIGHTGREEN", "LIGHTCYAN",
    "LIGHTRED", "LIGHTMAGENTA", "YELLOW", "WHITE"};

void scroll_down(int x1, int y1, int x2, int y2, int lines, int attr)
{
    union REGS r;
    r.h.ah = 0x07;
    r.h.al = (char)lines;
    r.h.bh = (char)attr;
    r.h.ch = (char)(y1 - 1);
    r.h.cl = (char)(x1 - 1);
    r.h.dh = (char)(y2 - 1);
    r.h.dl = (char)(x2 - 1);
    int86(0x10, &r, &r);
}

int main(void)
{
    int bg, fg, i;

    textattr(0x07);
    window(X1, Y1, X2, Y2);
    clrscr();
    // 1
    for (bg = 0; bg <= 7; bg++)
        for (fg = 0; fg <= 15; fg++)
        {
            delay(T);
            scroll_down(X1, Y1, X2, Y2, S, (bg << 4) | fg);
            gotoxy(1, 1);
            textbackground(bg);
            textcolor(fg);
            cprintf(" Фон: %-7s  Символ: %-11s ",
                    bg_rus[bg], fg_eng[fg]);
        }

    // 2
    textbackground(BLACK);
    for (i = 0;; i++)
    {
        if (kbhit())
            break;
        delay(T);
        scroll_down(X1, Y1, X2, Y2, S, 0x07);
        gotoxy(1, 1);
        textcolor(i % 16);
        cprintf(" Сообщение №%-3d  fg=%s", i, fg_eng[i % 16]);
    }

    textattr(0x07);
    window(1, 1, 80, 25);
    clrscr();
    return 0;
}